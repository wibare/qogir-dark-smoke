/* GTK-SMOKE THEME FOR ROFI */
/* Réplica del tema Qogir-Dark-Smoke-Compact (GTK3/GTK4) */

* {
    font:   "Fira Code Bold 9";

    background-color:   transparent;
    text-color:         #cbbfbf;

    margin:     0px;
    padding:    0px;
    spacing:    0px;
}

window {
    location:       north;
    y-offset:       calc(50% - 176px);
    width:          500;

    background-color:   #222222;
    border-color:       rgba ( 203, 191, 191, 12 % );
    border:             1px;
    border-radius:      4px;
}

mainbox {
    padding:    4px;
}

inputbar {
    background-color:   #262626;
    border-color:       rgba ( 203, 191, 191, 12 % );
    border:             1px;
    border-radius:      2px;

    padding:    5px 10px;
    spacing:    8px;
    children:   [ prompt, entry ];
}

prompt {
    text-color: #b5abab;
}

entry {
    placeholder:         "Search";
    placeholder-color:   #737373;
    text-color:          #b5abab;
}

message {
    margin:             4px 0 0;
    border-radius:      2px;
    border-color:       rgba ( 203, 191, 191, 12 % );
    background-color:   #262626;
}

textbox {
    padding:    6px 10px;
}

listview {
    background-color:   transparent;

    margin:     4px 0 0;
    lines:      5;
    columns:    1;

    fixed-height: false;
}

element {
    padding:        4px 8px;
    spacing:        8px;
    border-radius:  2px;
    border:         1px;
    border-color:   rgba ( 0, 0, 0, 0 );
}

element normal active,
element alternate active {
    text-color: #cbbfbf;
}

element selected normal,
element selected active {
    background-color:   #393939;
    border-color:       rgba ( 203, 191, 191, 24 % );
}

element selected active {
    border-color: #b3b3b3;
}

element-icon {
    size:           24px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
    margin: 2px 0 0 0;
}

element-description {
    font:           "Fira Code Bold 9";
    text-color:     #737373;
}